# 服务器端口
PORT=3000

# 允许跨域的前端地址（用逗号分隔多个地址）
CORS_ORIGINS=https://shenwen.578388.xyz,https://578388.xyz,http://localhost:8080

# JWT/Token 密钥（请改成一个随机字符串）
TOKEN_SECRET=please-change-this-to-a-random-string

# 邮件发送配置（用于注册验证码）
# Email sending configuration (for registration verification code)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_FROM=shenwenAI <your-email@example.com>
