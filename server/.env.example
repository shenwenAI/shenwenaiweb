# 服务器端口
PORT=3000

# 允许跨域的前端地址（用逗号分隔多个地址）
CORS_ORIGINS=https://578388.xyz,https://shenwen.578388.xyz,http://578388.xyz,http://shenwen.578388.xyz,http://localhost:8080

# JWT/Token 密钥（请改成一个随机字符串）
TOKEN_SECRET=please-change-this-to-a-random-string

# ==================== 邮件发送配置 ====================
# Email sending configuration (for registration verification code)
#
# SMTP 服务器地址和端口
# 常用服务: smtp.gmail.com:465, smtp.qq.com:465, smtp.163.com:465
# 自建邮件服务: 你的域名 SMTP 服务器地址
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true

# SMTP 登录凭据
EMAIL_USER=noreply@example.com
EMAIL_PASS=your-email-password

# 发件人显示名称和地址（自定义域名邮箱格式）
# 建议使用自定义域名邮箱如: shenwenAI <noreply@yourdomain.com>
EMAIL_FROM=shenwenAI <noreply@example.com>

# ==================== DKIM 签名配置（可选，推荐） ====================
# DKIM signing configuration (optional, recommended for custom domain)
#
# DKIM 用于验证邮件确实来自你的域名，提高邮件送达率，防止被标记为垃圾邮件
# 需要配合域名 DNS TXT 记录使用（详见 README.md）
#
# 你的域名（如 578388.xyz）
DKIM_DOMAIN=
# DKIM 选择器（默认 default，对应 DNS 记录 default._domainkey.578388.xyz）
DKIM_SELECTOR=default
# DKIM 私钥文件路径（PEM 格式）
DKIM_PRIVATE_KEY_PATH=

# ==================== 管理员配置 ====================
# 管理员邮箱（用于接收联系表单消息及系统通知）
# Admin email address (receives contact form messages and system notifications)
ADMIN_EMAIL=admin@example.com
